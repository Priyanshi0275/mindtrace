# Django
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://mindtrace:mindtrace@localhost:5432/mindtrace

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS - your Vercel frontend URL goes here in production, e.g.:
# CORS_ALLOWED_ORIGINS=https://mindtrace.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- LLM (OpenAI-compatible client, backend is swappable) ---

# Option 1 (local dev, zero cost, needs a machine that can run Ollama):
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.1:8b

# Option 2 (RECOMMENDED for Render deployment -- Render's free tier can't
# reliably self-host Ollama, so use Groq's free OpenAI-compatible API
# instead. Get a free key at https://console.groq.com/keys):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# OPENAI_MODEL=llama-3.1-8b-instant

# Option 3 (real OpenAI, small real cost, only if you want frontier quality):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
